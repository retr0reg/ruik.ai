# Notion Integration
# Create an integration at https://www.notion.so/my-integrations
NOTION_SECRET=secret_xxxxxxxxxxxxx

# Blog Database ID (from your Notion blog database URL)
# The database should have: Name/Title (title), Author (rich_text or people), Date (date)
NOTION_BLOG_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (for /notes)
# Account ID: dashboard → R2 → Overview (right sidebar)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API token: dashboard → R2 → Manage R2 API Tokens → Create token (Object Read)
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=ruik-notes
# Public base URL: either a custom domain bound to the bucket
# or the bucket's public r2.dev URL (enable "Public access" first)
R2_PUBLIC_BASE_URL=https://notes.ruik.ai
